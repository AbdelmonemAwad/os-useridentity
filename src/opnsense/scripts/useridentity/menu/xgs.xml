<menu>
    <!--
        On an XGS appliance - os-xgs-npu installed - the page is in the XGS section, with the
        appliance's own pages; the section has the name and attributes os-xgs-npu gives it, so the two
        menu files make one section. It sits in os-xgs-npu's order, which is OPNsense's own: the
        appliance's pages (10-45), the family's plugins (50-58, all taken; the new plugins of the plan
        from 59, 48 and the number of their plan), Updates, Problem Reports and the tools (80-89), the
        logs (90-92), About (99). This one is 60: 48 and its plan's 12 (settled point 12); 59 is
        os-appcontrol's. place-menu.sh copies this file, or own.xml, to the model's Menu/Menu.xml.
    -->
    <XGS VisibleName="XGS" cssClass="fa fa-microchip fa-fw" order="35">
        <UserIdentity order="60" VisibleName="User Identity" cssClass="fa fa-id-badge fa-fw" url="/ui/useridentity"/>
    </XGS>
</menu>
